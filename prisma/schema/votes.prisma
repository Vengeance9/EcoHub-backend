model Vote {
  id        String   @id @default(uuid())
  type      VoteType
  userId    String
  ideaId    String
  downvotes Int?
  upvotes   Int?
  idea      Idea     @relation(fields: [ideaId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, ideaId])
}
